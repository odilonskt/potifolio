rules_version = '2';

// Todo acesso aos dados passa pelo servidor do site (Firebase Admin SDK), que ignora
// estas regras. Nenhum navegador ou app cliente pode ler ou escrever diretamente:
// isso protege contatos (com e-mail, telefone e IP), trajetória e posts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
